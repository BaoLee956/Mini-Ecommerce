+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.entity.OrderItem;
+import org.example.miniecommerce.entity.OrderStatus;
+import org.example.miniecommerce.dto.order.CreateOrderRequest;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+
+/**
+ * Strategy Pattern: Chiến lược xử lý đơn hàng giao nhanh
+ */
+@Service
+public class ExpressOrderStrategy implements OrderProcessingStrategy {
+
+    private static final BigDecimal EXPRESS_SHIPPING_FEE = new BigDecimal("15.00");
+    private static final BigDecimal EXPRESS_SURCHARGE = new BigDecimal("0.10"); // Phụ phí 10%
+
+    @Override
+    public BigDecimal calculateTotal(Order order) {
+        BigDecimal subtotal = order.getItems().stream()
+                .map(item -> item.getPrice().multiply(BigDecimal.valueOf(item.getQuantity())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+
+        BigDecimal shippingFee = calculateShippingFee(order);
+        BigDecimal surcharge = subtotal.multiply(EXPRESS_SURCHARGE);
+
+        return subtotal.add(shippingFee).add(surcharge);
+    }
+
+    @Override
+    public boolean validateOrder(CreateOrderRequest request) {
+        if (request.items() == null || request.items().isEmpty()) {
+            return false;
+        }
+
+        // Kiểm tra các điều kiện cho đơn hàng express
+        return request.items().stream()
+                .allMatch(item -> item.quantity() > 0 && item.quantity() <= 3); // Giới hạn số lượng mỗi item
+    }
+
+    @Override
+    public void applyDiscounts(Order order) {
+        // Không có giảm giá cho đơn hàng express
+    }
+
+    @Override
+    public void processSpecialItems(Order order) {
+        // Xử lý ưu tiên cho đơn hàng express
+        System.out.println("Processing express order " + order.getId() + " with priority handling");
+        order.setStatus(OrderStatus.SHIPPED); // Chuyển trực tiếp sang SHIPPED
+    }
+
+    @Override
+    public BigDecimal calculateShippingFee(Order order) {
+        return EXPRESS_SHIPPING_FEE;
+    }
+
+    @Override
+    public boolean canHandle(CreateOrderRequest request) {
+        // Đơn hàng express cần có flag đặc biệt hoặc điều kiện riêng
+        // Trong ví dụ này, chúng ta có thể check bằng cách khác
+        return false; // Cần được chỉ định rõ ràng
+    }
+
+    @Override
+    public String getStrategyName() {
+        return "EXPRESS";
+    }
+}
