+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.dto.order.CreateOrderRequest;
+
+/**
+ * Template Method Pattern: Abstract class định nghĩa workflow xử lý đơn hàng
+ */
+public abstract class OrderProcessor {
+
+    protected final OrderProcessingStrategyFactory strategyFactory;
+
+    public OrderProcessor(OrderProcessingStrategyFactory strategyFactory) {
+        this.strategyFactory = strategyFactory;
+    }
+
+    /**
+     * Template Method: Workflow chính để xử lý đơn hàng
+     */
+    public final Order processOrder(CreateOrderRequest request) {
+        // Step 1: Validate request
+        validateRequest(request);
+
+        // Step 2: Check inventory
+        checkInventory(request);
+
+        // Step 3: Create order using strategy
+        OrderProcessingStrategy strategy = strategyFactory.getStrategy(request);
+        Order order = createOrder(request, strategy);
+
+        // Step 4: Calculate total
+        calculateTotal(order, strategy);
+
+        // Step 5: Apply discounts
+        applyDiscounts(order, strategy);
+
+        // Step 6: Process special items
+        processSpecialItems(order, strategy);
+
+        // Step 7: Save order
+        saveOrder(order);
+
+        // Step 8: Send notifications
+        sendNotifications(order);
+
+        return order;
+    }
+
+    // Abstract methods - must be implemented by subclasses
+    protected abstract void validateRequest(CreateOrderRequest request);
+    protected abstract void checkInventory(CreateOrderRequest request);
+    protected abstract Order createOrder(CreateOrderRequest request, OrderProcessingStrategy strategy);
+
+    // Hook methods - can be overridden by subclasses
+    protected void calculateTotal(Order order, OrderProcessingStrategy strategy) {
+        order.setTotalAmount(strategy.calculateTotal(order));
+    }
+
+    protected void applyDiscounts(Order order, OrderProcessingStrategy strategy) {
+        strategy.applyDiscounts(order);
+    }
+
+    protected void processSpecialItems(Order order, OrderProcessingStrategy strategy) {
+        strategy.processSpecialItems(order);
+    }
+
+    protected abstract void saveOrder(Order order);
+
+    protected void sendNotifications(Order order) {
+        System.out.println("Order " + order.getId() + " has been created successfully");
+        System.out.println("Total amount: $" + order.getTotalAmount());
+        System.out.println("Status: " + order.getStatus());
+    }
+}
