@@ -0,0 +1,79 @@
+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.dto.order.CreateOrderRequest;
+import org.example.miniecommerce.factory.OrderFactory;
+import org.example.miniecommerce.repository.OrderRepository;
+import org.springframework.stereotype.Service;
+
+/**
+ * Template Method Pattern: Concrete implementation cho việc xử lý đơn hàng thông thường
+ */
+@Service
+public class StandardOrderProcessor extends OrderProcessor {
+
+    private final OrderFactory orderFactory;
+    private final OrderRepository orderRepository;
+    private final ProductService productService;
+
+    public StandardOrderProcessor(OrderProcessingStrategyFactory strategyFactory,
+                                OrderFactory orderFactory,
+                                OrderRepository orderRepository,
+                                ProductService productService) {
+        super(strategyFactory);
+        this.orderFactory = orderFactory;
+        this.orderRepository = orderRepository;
+        this.productService = productService;
+    }
+
+    @Override
+    protected void validateRequest(CreateOrderRequest request) {
+        if (request == null) {
+            throw new IllegalArgumentException("Order request cannot be null");
+        }
+
+        if (request.items() == null || request.items().isEmpty()) {
+            throw new IllegalArgumentException("Order must contain at least one item");
+        }
+
+        // Validate each item
+        request.items().forEach(item -> {
+            if (item.productId() == null) {
+                throw new IllegalArgumentException("Product ID cannot be null");
+            }
+            if (item.quantity() <= 0) {
+                throw new IllegalArgumentException("Quantity must be positive");
+            }
+        });
+    }
+
+    @Override
+    protected void checkInventory(CreateOrderRequest request) {
+        // Check inventory for each product
+        request.items().forEach(item -> {
+            var product = productService.get(item.productId());
+            if (product.stockQuantity() < item.quantity()) {
+                throw new IllegalStateException("Insufficient stock for product: " + product.name());
+            }
+        });
+    }
+
+    @Override
+    protected Order createOrder(CreateOrderRequest request, OrderProcessingStrategy strategy) {
+        // Use OrderFactory to create order (existing functionality)
+        return orderFactory.createOrder(1L, request.items()); // userId = 1L for demo
+    }
+
+    @Override
+    protected void saveOrder(Order order) {
+        orderRepository.save(order);
+        System.out.println("Order saved with ID: " + order.getId());
+    }
+
+    @Override
+    protected void sendNotifications(Order order) {
+        super.sendNotifications(order);
+        // Additional notification logic for standard orders
+        System.out.println("Standard order processing completed");
+    }
+}
