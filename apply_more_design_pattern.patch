+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.entity.OrderStatus;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+
+/**
+ * Decorator Pattern: Thêm tính năng giao hàng nhanh
+ */
+@Service
+public class ExpressShippingDecorator implements OrderDecorator {
+
+    private static final BigDecimal EXPRESS_SHIPPING_FEE = new BigDecimal("10.00");
+
+    @Override
+    public void apply(Order order) {
+        BigDecimal newTotal = order.getTotalAmount().add(EXPRESS_SHIPPING_FEE);
+        order.setTotalAmount(newTotal);
+        // Có thể thay đổi status để ưu tiên xử lý
+        System.out.println("Express shipping applied to order " + order.getId());
+    }
+
+    @Override
+    public BigDecimal getAdditionalCost() {
+        return EXPRESS_SHIPPING_FEE;
+    }
+
+    @Override
+    public String getDescription() {
+        return "Express Shipping (+$" + EXPRESS_SHIPPING_FEE + ")";
+    }
+
+    @Override
+    public boolean canApply(Order order) {
+        // Chỉ áp dụng cho đơn hàng chưa được ship
+        return order.getStatus() == OrderStatus.PENDING || order.getStatus() == OrderStatus.PAID;
+    }
+}
