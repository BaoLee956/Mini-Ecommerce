++package org.example.miniecommerce.service;
++
++import org.example.miniecommerce.dto.order.CreateOrderRequest;
++import org.springframework.stereotype.Component;
++
++import java.util.List;
++
++/**
++ * Strategy Pattern: Factory để chọn chiến lược xử lý đơn hàng phù hợp
++ */
++@Component
++public class OrderProcessingStrategyFactory {
++
++    private final List<OrderProcessingStrategy> strategies;
++
++    public OrderProcessingStrategyFactory(List<OrderProcessingStrategy> strategies) {
++        this.strategies = strategies;
++    }
++
++    /**
++     * Chọn chiến lược xử lý phù hợp cho đơn hàng
++     */
++    public OrderProcessingStrategy getStrategy(CreateOrderRequest request) {
++        // Ưu tiên WholesaleOrderStrategy nếu đủ điều kiện
++        for (OrderProcessingStrategy strategy : strategies) {
++            if (strategy.canHandle(request)) {
++                return strategy;
++            }
++        }
++
++        // Mặc định sử dụng StandardOrderStrategy
++        return strategies.stream()
++                .filter(strategy -> "STANDARD".equals(strategy.getStrategyName()))
++                .findFirst()
++                .orElseThrow(() -> new IllegalStateException("No suitable strategy found"));
++    }
++
++    /**
++     * Lấy strategy theo tên
