+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.dto.order.CreateOrderRequest;
+import java.math.BigDecimal;
+
+/**
+ * Strategy Pattern: Interface cho các chiến lược xử lý đơn hàng khác nhau
+ */
+public interface OrderProcessingStrategy {
+
+    /**
+     * Tính toán tổng tiền đơn hàng
+     */
+    BigDecimal calculateTotal(Order order);
+
+    /**
+     * Validate đơn hàng
+     */
+    boolean validateOrder(CreateOrderRequest request);
+
+    /**
+     * Áp dụng các ưu đãi đặc biệt
+     */
+    void applyDiscounts(Order order);
+
+    /**
+     * Xử lý các item đặc biệt
+     */
+    void processSpecialItems(Order order);
+
+    /**
+     * Tính phí shipping
+     */
+    BigDecimal calculateShippingFee(Order order);
+
+    /**
+     * Kiểm tra loại đơn hàng này có áp dụng strategy này không
+     */
+    boolean canHandle(CreateOrderRequest request);
+
+    /**
+     * Lấy tên strategy
+     */
+    String getStrategyName();
+}
