+package org.example.miniecommerce.state;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.entity.OrderStatus;
+import org.springframework.stereotype.Component;
+
+/**
+ * State Pattern: Trạng thái PAID - đơn hàng đã thanh toán, chờ giao hàng
+ */
+@Component
+public class PaidOrderState implements OrderState {
+
+    @Override
+    public void handlePayment(Order order) {
+        throw new IllegalStateException("Order is already paid");
+    }
+
+    @Override
+    public void handleShipping(Order order) {
+        order.setStatus(OrderStatus.SHIPPED);
+        System.out.println("Order " + order.getId() + " has been shipped");
+    }
+
+    @Override
+    public void cancel(Order order) {
+        throw new IllegalStateException("Cannot cancel order that has already been paid");
+    }
+
+    @Override
+    public boolean canTransitionTo(OrderStatus newStatus) {
+        return newStatus == OrderStatus.SHIPPED;
+    }
+
+    @Override
+    public OrderStatus getStatus() {
+        return OrderStatus.PAID;
+    }
+
+    @Override
+    public void complete(Order order) {
+        throw new IllegalStateException("Cannot complete order that hasn't been shipped yet");
+    }
+}
