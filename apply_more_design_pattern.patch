+package org.example.miniecommerce.state;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.entity.OrderStatus;
+import org.springframework.stereotype.Component;
+
+/**
+ * State Pattern: Trạng thái PENDING - đơn hàng mới tạo, chờ thanh toán
+ */
+@Component
+public class PendingOrderState implements OrderState {
+
+    @Override
+    public void handlePayment(Order order) {
+        // Chuyển sang trạng thái PAID
+        order.setStatus(OrderStatus.PAID);
+        System.out.println("Order " + order.getId() + " has been paid successfully");
+    }
+
+    @Override
+    public void handleShipping(Order order) {
+        throw new IllegalStateException("Cannot ship order that hasn't been paid yet");
+    }
+
+    @Override
+    public void cancel(Order order) {
+        order.setStatus(OrderStatus.CANCELLED);
+        System.out.println("Order " + order.getId() + " has been cancelled");
+    }
+
+    @Override
+    public boolean canTransitionTo(OrderStatus newStatus) {
+        return newStatus == OrderStatus.PAID || newStatus == OrderStatus.CANCELLED;
+    }
+
+    @Override
+    public OrderStatus getStatus() {
+        return OrderStatus.PENDING;
+    }
+
+    @Override
+    public void complete(Order order) {
+        throw new IllegalStateException("Cannot complete order that hasn't been paid and shipped");
+    }
+}
