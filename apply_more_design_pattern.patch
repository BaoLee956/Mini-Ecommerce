@@ -0,0 +1,89 @@
+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.entity.OrderItem;
+import org.example.miniecommerce.dto.order.CreateOrderRequest;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+
+/**
+ * Strategy Pattern: Chiến lược xử lý đơn hàng bán buôn
+ */
+@Service
+public class WholesaleOrderStrategy implements OrderProcessingStrategy {
+
+    private static final BigDecimal WHOLESALE_DISCOUNT_RATE = new BigDecimal("0.15"); // Giảm 15%
+    private static final BigDecimal FREE_SHIPPING_THRESHOLD = new BigDecimal("500.00");
+    private static final int MIN_WHOLESALE_QUANTITY = 10;
+
+    @Override
+    public BigDecimal calculateTotal(Order order) {
+        BigDecimal subtotal = order.getItems().stream()
+                .map(item -> item.getPrice().multiply(BigDecimal.valueOf(item.getQuantity())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+
+        // Áp dụng giảm giá bán buôn
+        BigDecimal discount = subtotal.multiply(WHOLESALE_DISCOUNT_RATE);
+        BigDecimal discountedSubtotal = subtotal.subtract(discount);
+
+        BigDecimal shippingFee = calculateShippingFee(order);
+
+        return discountedSubtotal.add(shippingFee);
+    }
+
+    @Override
+    public boolean validateOrder(CreateOrderRequest request) {
+        if (request.items() == null || request.items().isEmpty()) {
+            return false;
+        }
+
+        // Kiểm tra tổng số lượng tối thiểu cho bán buôn
+        int totalQuantity = request.items().stream()
+                .mapToInt(item -> item.quantity())
+                .sum();
+
+        return totalQuantity >= MIN_WHOLESALE_QUANTITY;
+    }
+
+    @Override
+    public void applyDiscounts(Order order) {
+        // Giảm giá bán buôn đã được áp dụng trong calculateTotal
+    }
+
+    @Override
+    public void processSpecialItems(Order order) {
+        // Xử lý đặc biệt cho đơn hàng bán buôn
+        System.out.println("Processing wholesale order " + order.getId() + " with special handling");
+    }
+
+    @Override
+    public BigDecimal calculateShippingFee(Order order) {
+        BigDecimal subtotal = order.getItems().stream()
+                .map(item -> item.getPrice().multiply(BigDecimal.valueOf(item.getQuantity())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+
+        // Miễn phí ship cho đơn hàng bán buôn trên 500
+        if (subtotal.compareTo(FREE_SHIPPING_THRESHOLD) >= 0) {
+            return BigDecimal.ZERO;
+        }
+
+        // Phí ship giảm cho bán buôn
+        return new BigDecimal("2.00");
+    }
+
+    @Override
+    public boolean canHandle(CreateOrderRequest request) {
+        // Kiểm tra điều kiện cho đơn hàng bán buôn
+        int totalQuantity = request.items().stream()
+                .mapToInt(item -> item.quantity())
+                .sum();
+
+        return totalQuantity >= MIN_WHOLESALE_QUANTITY;
+    }
+
+    @Override
+    public String getStrategyName() {
+        return "WHOLESALE";
+    }
+}
