+package org.example.miniecommerce.state;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.entity.OrderStatus;
+
+/**
+ * State Pattern: Interface cho các trạng thái đơn hàng
+ */
+public interface OrderState {
+
+    /**
+     * Xử lý khi đơn hàng được thanh toán
+     */
+    void handlePayment(Order order);
+
+    /**
+     * Xử lý khi đơn hàng được giao
+     */
+    void handleShipping(Order order);
+
+    /**
+     * Hủy đơn hàng
+     */
+    void cancel(Order order);
+
+    /**
+     * Kiểm tra có thể chuyển sang trạng thái mới không
+     */
+    boolean canTransitionTo(OrderStatus newStatus);
+
+    /**
+     * Lấy trạng thái hiện tại
+     */
+    OrderStatus getStatus();
+
+    /**
+     * Xử lý khi đơn hàng hoàn thành
+     */
+    void complete(Order order);
+}
