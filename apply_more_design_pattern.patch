@@ -0,0 +1,92 @@
+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.entity.OrderItem;
+import org.example.miniecommerce.dto.order.CreateOrderRequest;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+
+/**
+ * Strategy Pattern: Chiến lược xử lý đơn hàng thông thường
+ */
+@Service
+public class StandardOrderStrategy implements OrderProcessingStrategy {
+
+    private static final BigDecimal STANDARD_SHIPPING_FEE = new BigDecimal("5.00");
+    private static final int BULK_DISCOUNT_THRESHOLD = 5; // Số lượng tối thiểu để có giảm giá
+
+    @Override
+    public BigDecimal calculateTotal(Order order) {
+        BigDecimal subtotal = order.getItems().stream()
+                .map(item -> item.getPrice().multiply(BigDecimal.valueOf(item.getQuantity())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+
+        BigDecimal shippingFee = calculateShippingFee(order);
+        BigDecimal discount = calculateDiscount(order);
+
+        return subtotal.add(shippingFee).subtract(discount);
+    }
+
+    @Override
+    public boolean validateOrder(CreateOrderRequest request) {
+        if (request.items() == null || request.items().isEmpty()) {
+            return false;
+        }
+
+        // Kiểm tra số lượng không âm
+        return request.items().stream()
+                .allMatch(item -> item.quantity() > 0);
+    }
+
+    @Override
+    public void applyDiscounts(Order order) {
+        // Giảm giá 5% cho đơn hàng trên 100
+        BigDecimal subtotal = order.getItems().stream()
+                .map(item -> item.getPrice().multiply(BigDecimal.valueOf(item.getQuantity())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+
+        if (subtotal.compareTo(new BigDecimal("100.00")) > 0) {
+            BigDecimal discount = subtotal.multiply(new BigDecimal("0.05"));
+            order.setTotalAmount(order.getTotalAmount().subtract(discount));
+        }
+    }
+
+    @Override
+    public void processSpecialItems(Order order) {
+        // Không có xử lý đặc biệt cho đơn hàng thông thường
+    }
+
+    @Override
+    public BigDecimal calculateShippingFee(Order order) {
+        // Phí ship tiêu chuẩn
+        return STANDARD_SHIPPING_FEE;
+    }
+
+    @Override
+    public boolean canHandle(CreateOrderRequest request) {
+        // Đơn hàng thông thường không có điều kiện đặc biệt
+        return true;
+    }
+
+    @Override
+    public String getStrategyName() {
+        return "STANDARD";
+    }
+
+    private BigDecimal calculateDiscount(Order order) {
+        // Giảm giá theo số lượng
+        int totalQuantity = order.getItems().stream()
+                .mapToInt(OrderItem::getQuantity)
+                .sum();
+
+        if (totalQuantity >= BULK_DISCOUNT_THRESHOLD) {
+            BigDecimal subtotal = order.getItems().stream()
+                    .map(item -> item.getPrice().multiply(BigDecimal.valueOf(item.getQuantity())))
+                    .reduce(BigDecimal.ZERO, BigDecimal::add);
+            return subtotal.multiply(new BigDecimal("0.03")); // Giảm 3%
+        }
+
+        return BigDecimal.ZERO;
+    }
+}
