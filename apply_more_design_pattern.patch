@@ -0,0 +1,72 @@
+package org.example.miniecommerce.state;
+
+import org.example.miniecommerce.entity.Order;
+import org.example.miniecommerce.entity.OrderStatus;
+import org.springframework.stereotype.Component;
+
+import java.util.Map;
+
+/**
+ * State Pattern: Context class để quản lý việc chuyển đổi giữa các trạng thái
+ */
+@Component
+public class OrderStateContext {
+
+    private final Map<OrderStatus, OrderState> states;
+
+    public OrderStateContext(PendingOrderState pendingState,
+                           PaidOrderState paidState,
+                           ShippedOrderState shippedState,
+                           CompletedOrderState completedState,
+                           CancelledOrderState cancelledState) {
+        this.states = Map.of(
+            OrderStatus.PENDING, pendingState,
+            OrderStatus.PAID, paidState,
+            OrderStatus.SHIPPED, shippedState,
+            OrderStatus.DELIVERED, shippedState, // DELIVERED cũng sử dụng ShippedOrderState
+            OrderStatus.COMPLETED, completedState,
+            OrderStatus.CANCELLED, cancelledState
+        );
+    }
+
+    /**
+     * Lấy state hiện tại của đơn hàng
+     */
+    public OrderState getCurrentState(Order order) {
+        return states.get(order.getStatus());
+    }
+
+    /**
+     * Chuyển đổi trạng thái đơn hàng
+     */
+    public void transitionTo(Order order, OrderStatus newStatus) {
+        OrderState currentState = getCurrentState(order);
+
+        if (currentState.canTransitionTo(newStatus)) {
+            order.setStatus(newStatus);
+            System.out.println("Order " + order.getId() + " transitioned from " +
+                             currentState.getStatus() + " to " + newStatus);
+        } else {
+            throw new IllegalStateException("Cannot transition from " + order.getStatus() +
+                                          " to " + newStatus);
+        }
+    }
+
+    /**
+     * Thực hiện hành động theo trạng thái hiện tại
+     */
+    public void executeAction(Order order, OrderAction action) {
+        OrderState currentState = getCurrentState(order);
+
+        switch (action) {
+            case PAY -> currentState.handlePayment(order);
+            case SHIP -> currentState.handleShipping(order);
+            case CANCEL -> currentState.cancel(order);
+            case COMPLETE -> currentState.complete(order);
+        }
+    }
+
+    public enum OrderAction {
+        PAY, SHIP, CANCEL, COMPLETE
+    }
+}
