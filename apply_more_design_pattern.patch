+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+
+/**
+ * Decorator Pattern: Thêm tính năng bảo hiểm cho đơn hàng
+ */
+@Service
+public class InsuranceDecorator implements OrderDecorator {
+
+    private static final BigDecimal INSURANCE_RATE = new BigDecimal("0.02"); // 2% giá trị đơn hàng
+
+    @Override
+    public void apply(Order order) {
+        BigDecimal insuranceFee = order.getTotalAmount().multiply(INSURANCE_RATE);
+        BigDecimal newTotal = order.getTotalAmount().add(insuranceFee);
+        order.setTotalAmount(newTotal);
+        System.out.println("Insurance applied to order " + order.getId() + " with fee: $" + insuranceFee);
+    }
+
+    @Override
+    public BigDecimal getAdditionalCost() {
+        // Chi phí động dựa trên giá trị đơn hàng
+        return BigDecimal.ZERO; // Sẽ được tính trong apply()
+    }
+
+    @Override
+    public String getDescription() {
+        return "Insurance (2% of order value)";
+    }
+
+    @Override
+    public boolean canApply(Order order) {
+        // Có thể áp dụng cho đơn hàng có giá trị cao
+        return order.getTotalAmount().compareTo(new BigDecimal("50.00")) > 0;
+    }
+}
