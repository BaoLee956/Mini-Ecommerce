@@ -0,0 +1,111 @@
+package org.example.miniecommerce.service;
+
+import org.example.miniecommerce.entity.Order;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Decorator Pattern: Manager để áp dụng các decorator cho đơn hàng
+ */
+@Service
+public class OrderDecoratorManager {
+
+    private final List<OrderDecorator> availableDecorators;
+
+    public OrderDecoratorManager(GiftWrappingDecorator giftWrapping,
+                               ExpressShippingDecorator expressShipping,
+                               InsuranceDecorator insurance) {
+        this.availableDecorators = List.of(giftWrapping, expressShipping, insurance);
+    }
+
+    /**
+     * Áp dụng một decorator cụ thể cho đơn hàng
+     */
+    public void applyDecorator(Order order, String decoratorName) {
+        OrderDecorator decorator = findDecoratorByName(decoratorName);
+
+        if (decorator.canApply(order)) {
+            decorator.apply(order);
+            System.out.println("Applied decorator: " + decorator.getDescription());
+        } else {
+            throw new IllegalStateException("Cannot apply decorator '" + decoratorName +
+                                          "' to order in status: " + order.getStatus());
+        }
+    }
+
+    /**
+     * Áp dụng nhiều decorators cùng lúc
+     */
+    public void applyDecorators(Order order, List<String> decoratorNames) {
+        List<OrderDecorator> applicableDecorators = new ArrayList<>();
+
+        for (String name : decoratorNames) {
+            OrderDecorator decorator = findDecoratorByName(name);
+            if (decorator.canApply(order)) {
+                applicableDecorators.add(decorator);
+            } else {
+                System.out.println("Skipping decorator '" + name + "' - cannot apply to current order");
+            }
+        }
+
+        // Áp dụng tất cả decorators hợp lệ
+        for (OrderDecorator decorator : applicableDecorators) {
+            decorator.apply(order);
+        }
+    }
+
+    /**
+     * Tính tổng chi phí thêm từ decorators
+     */
+    public BigDecimal calculateTotalAdditionalCost(Order order, List<String> decoratorNames) {
+        BigDecimal totalCost = BigDecimal.ZERO;
+
+        for (String name : decoratorNames) {
+            OrderDecorator decorator = findDecoratorByName(name);
+            if (decorator.canApply(order)) {
+                BigDecimal cost = decorator.getAdditionalCost();
+                if (cost.compareTo(BigDecimal.ZERO) > 0) {
+                    totalCost = totalCost.add(cost);
+                }
+            }
+        }
+
+        return totalCost;
+    }
+
+    /**
+     * Lấy danh sách tất cả decorators có sẵn
+     */
+    public List<String> getAvailableDecorators() {
+        return availableDecorators.stream()
+                .map(OrderDecorator::getDescription)
+                .toList();
+    }
+
+    /**
+     * Kiểm tra decorator có tồn tại không
+     */
+    public boolean isDecoratorAvailable(String decoratorName) {
+        return availableDecorators.stream()
+                .anyMatch(d -> decoratorName.equalsIgnoreCase(getDecoratorName(d)));
+    }
+
+    private OrderDecorator findDecoratorByName(String name) {
+        return availableDecorators.stream()
+                .filter(d -> name.equalsIgnoreCase(getDecoratorName(d)))
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("Decorator not found: " + name));
+    }
+
+    private String getDecoratorName(OrderDecorator decorator) {
+        String description = decorator.getDescription();
+        // Extract name from description (e.g., "Gift Wrapping (+$3.00)" -> "Gift Wrapping")
+        if (description.contains(" (+$")) {
+            return description.substring(0, description.indexOf(" (+$"));
+        }
+        return description;
+    }
+}
